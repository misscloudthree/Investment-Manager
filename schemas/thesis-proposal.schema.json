{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-manager.example/schemas/thesis-proposal.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "pattern": "^(TWSE|TPEx):[0-9A-Z]+$"
    },
    "asset_type": {
      "enum": [
        "stock",
        "etf"
      ]
    },
    "proposal_status": {
      "enum": [
        "draft",
        "needs_information",
        "ready_for_review"
      ]
    },
    "research_stage": {
      "enum": [
        "screening",
        "deep_research"
      ]
    },
    "research_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "data_mode": {
      "enum": [
        "mock",
        "public_sources",
        "user_documents"
      ]
    },
    "investment_thesis": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/claim"
      },
      "minItems": 0
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/claim"
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/claim"
      },
      "minItems": 0
    },
    "monitoring_kpis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kpi"
      },
      "minItems": 0
    },
    "quantitative_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger_id": {
            "type": "string",
            "minLength": 1
          },
          "kpi_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "const": "request_human_review"
          }
        },
        "required": [
          "trigger_id",
          "kpi_id",
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "qualitative_triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qualitative_trigger"
      },
      "minItems": 0
    },
    "invalidation_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "thesis_pillar_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "linked_kpi_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "action": {
            "const": "request_human_review"
          }
        },
        "required": [
          "criterion_id",
          "thesis_pillar_id",
          "condition",
          "linked_kpi_ids",
          "source_ids",
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_event_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "transmission": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "risk_id",
          "canonical_event_id",
          "description",
          "transmission",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "sufficient",
            "insufficient",
            "conflicting"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "confidence",
        "missing_fields",
        "conflicts",
        "limitations"
      ],
      "additionalProperties": false
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "skill_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_name": {
            "enum": [
              "opportunity-screener",
              "company-research"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "skill_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "skill_name",
          "revision",
          "skill_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "research_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "methodology_receipt": {
      "type": "object",
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "verification_method": {
          "enum": [
            "local_git",
            "bundle_hashes"
          ]
        },
        "integrity_status": {
          "const": "verified"
        },
        "origin_authentication": {
          "enum": [
            "trusted_repository",
            "user_compared_commit",
            "not_verified"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "web_access": {
              "enum": [
                "available",
                "unavailable",
                "not_tested"
              ]
            },
            "python": {
              "enum": [
                "available",
                "unavailable",
                "not_tested"
              ]
            },
            "data_apis": {
              "enum": [
                "available",
                "unavailable",
                "not_tested"
              ]
            }
          },
          "required": [
            "web_access",
            "python",
            "data_apis"
          ],
          "additionalProperties": false
        },
        "calculation_status": {
          "enum": [
            "not_run",
            "partially_checked",
            "checked"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "manifest_sha256",
        "files",
        "verification_method",
        "integrity_status",
        "origin_authentication",
        "capabilities",
        "calculation_status",
        "limitations"
      ],
      "additionalProperties": false
    },
    "research_priority": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low",
            "unranked"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "level",
        "rationale",
        "missing_information"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "bull",
              "base",
              "bear"
            ]
          },
          "drivers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "name",
          "drivers",
          "assessment",
          "source_ids",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "equity_analysis": {
      "$ref": "company-research.output.schema.json#/properties/company_analysis"
    },
    "etf_analysis": {
      "$ref": "company-research.output.schema.json#/properties/etf_analysis"
    },
    "memo_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "asset_id",
    "asset_type",
    "proposal_status",
    "research_stage",
    "research_timestamp",
    "data_cutoff",
    "data_mode",
    "investment_thesis",
    "supporting_evidence",
    "assumptions",
    "monitoring_kpis",
    "quantitative_triggers",
    "qualitative_triggers",
    "invalidation_criteria",
    "risk_factors",
    "data_quality",
    "source_references",
    "skill_versions",
    "research_commit_sha",
    "methodology_receipt",
    "research_priority",
    "scenarios",
    "memo_path"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "data_period": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "published_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "time_precision": {
          "enum": [
            "timestamp",
            "date",
            "unknown"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieval": {
          "enum": [
            "api",
            "official_document",
            "user_provided"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "source_id",
        "provider",
        "locator",
        "data_period",
        "published_at",
        "published_date",
        "time_precision",
        "retrieved_at",
        "retrieval",
        "confidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "timestamp"
              }
            }
          },
          "then": {
            "properties": {
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "published_date": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "date"
              }
            }
          },
          "then": {
            "properties": {
              "published_at": {
                "type": "null"
              },
              "published_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "published_at": {
                "type": "null"
              },
              "published_date": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "kpi": {
      "type": "object",
      "properties": {
        "kpi_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "reporting_frequency": {
          "enum": [
            "daily",
            "monthly",
            "quarterly",
            "annual",
            "event_driven"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "comparison_operator": {
          "enum": [
            "lt",
            "lte",
            "gt",
            "gte",
            "eq",
            "change",
            "unconfigured"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "threshold_rationale": {
          "type": "string",
          "minLength": 1
        },
        "threshold_basis": {
          "enum": [
            "evidence",
            "user_instruction",
            "unconfigured",
            "mock"
          ]
        },
        "observation_window": {
          "type": "object",
          "properties": {
            "periods": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "periods",
            "description"
          ],
          "additionalProperties": false
        },
        "freshness": {
          "type": "object",
          "properties": {
            "max_age_days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "require_latest_publication": {
              "type": "boolean"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "max_age_days",
            "require_latest_publication",
            "rationale"
          ],
          "additionalProperties": false
        },
        "missing_data_handling": {
          "enum": [
            "mark_unknown_and_request_data",
            "suspend_assessment"
          ]
        },
        "status": {
          "enum": [
            "configured",
            "unconfigured"
          ]
        }
      },
      "required": [
        "kpi_id",
        "metric_name",
        "unit",
        "reporting_frequency",
        "source_ids",
        "comparison_operator",
        "threshold",
        "threshold_rationale",
        "threshold_basis",
        "observation_window",
        "freshness",
        "missing_data_handling",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "configured"
              }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "number"
              },
              "comparison_operator": {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "eq",
                  "change"
                ]
              },
              "threshold_basis": {
                "enum": [
                  "evidence",
                  "user_instruction",
                  "mock"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "threshold": {
                "type": "null"
              },
              "comparison_operator": {
                "const": "unconfigured"
              },
              "threshold_basis": {
                "const": "unconfigured"
              }
            }
          }
        }
      ]
    },
    "qualitative_trigger": {
      "type": "object",
      "properties": {
        "trigger_id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "action": {
          "const": "request_human_review"
        }
      },
      "required": [
        "trigger_id",
        "condition",
        "rationale",
        "source_ids",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "asset_type": {
            "const": "etf"
          }
        }
      },
      "then": {
        "required": [
          "etf_analysis"
        ],
        "not": {
          "required": [
            "equity_analysis"
          ]
        }
      },
      "else": {
        "required": [
          "equity_analysis"
        ],
        "not": {
          "required": [
            "etf_analysis"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposal_status": {
            "const": "ready_for_review"
          }
        }
      },
      "then": {
        "properties": {
          "research_stage": {
            "const": "deep_research"
          },
          "investment_thesis": {
            "minItems": 3,
            "maxItems": 5
          },
          "supporting_evidence": {
            "minItems": 1
          },
          "monitoring_kpis": {
            "minItems": 1
          },
          "invalidation_criteria": {
            "minItems": 1
          },
          "source_references": {
            "minItems": 1
          },
          "data_quality": {
            "properties": {
              "status": {
                "const": "sufficient"
              },
              "missing_fields": {
                "maxItems": 0
              },
              "conflicts": {
                "maxItems": 0
              }
            }
          },
          "scenarios": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "bull"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "base"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "bear"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_quality": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient",
                  "conflicting"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proposal_status": {
            "enum": [
              "draft",
              "needs_information"
            ]
          }
        }
      }
    }
  ]
}

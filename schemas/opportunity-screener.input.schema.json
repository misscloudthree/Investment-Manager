{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-manager.example/schemas/opportunity-screener.input.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "horizon_months": {
      "type": "integer",
      "minimum": 1
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "source_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "official_url",
              "local_snapshot",
              "user_document"
            ]
          }
        },
        "required": [
          "locator",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "universe": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "tickers",
            "sector",
            "theme",
            "index",
            "all_market"
          ]
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/instrument"
          },
          "minItems": 0
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "enum": [
            "full",
            "sample"
          ]
        }
      },
      "required": [
        "mode",
        "instruments",
        "selector",
        "coverage"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tickers"
              }
            }
          },
          "then": {
            "properties": {
              "instruments": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "object",
      "properties": {
        "min_20d_turnover_twd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "min_20d_turnover_twd",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "stock_weights": {
      "type": "object",
      "properties": {
        "valuation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "momentum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sentiment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "growth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "valuation",
        "quality",
        "momentum",
        "sentiment",
        "growth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "as_of",
    "horizon_months",
    "base_currency",
    "source_inputs",
    "universe",
    "benchmark",
    "filters",
    "stock_weights"
  ],
  "additionalProperties": false
}

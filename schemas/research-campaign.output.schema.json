{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-manager.local/schemas/research-campaign.output.schema.json",
  "type": "object",
  "properties": {
    "campaign_version": {
      "const": "1.0"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_mode": {
      "enum": [
        "mock",
        "public_sources",
        "user_documents"
      ]
    },
    "scope": {
      "$ref": "https://investment-manager.local/schemas/market-snapshot.schema.json#/$defs/scope"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "methodology": {
      "type": "object",
      "properties": {
        "research_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "skill_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill_name": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "skill_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "skill_name",
              "revision",
              "skill_sha256"
            ],
            "additionalProperties": false
          }
        },
        "engine_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "research_commit_sha",
        "manifest_sha256",
        "skill_versions",
        "engine_sha256"
      ],
      "additionalProperties": false
    },
    "policy": {
      "$ref": "https://investment-manager.local/schemas/research-campaign.input.schema.json"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "declared_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "needs_data": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "ranked_count": {
          "type": "integer",
          "minimum": 0
        },
        "unranked_evaluated_count": {
          "type": "integer",
          "minimum": 0
        },
        "processing_complete": {
          "type": "boolean"
        },
        "research_complete": {
          "const": false
        }
      },
      "required": [
        "declared_count",
        "pending",
        "evaluated",
        "excluded",
        "needs_data",
        "failed",
        "ranked_count",
        "unranked_evaluated_count",
        "processing_complete",
        "research_complete"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "processing",
        "awaiting_deep_research",
        "blocked_no_comparable_candidates",
        "ready_for_synthesis_not_approved",
        "screening_complete_no_deep_budget"
      ]
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^(TWSE|TPEx):[0-9A-Z]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "comparison_group": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "dimension_scores": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            }
          },
          "dimension_coverage": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "factor_scores": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            }
          },
          "comparison_as_of": {
            "type": "string",
            "format": "date"
          },
          "peer_evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "peer_median": {
                  "type": "number"
                },
                "direction": {
                  "enum": [
                    "higher",
                    "lower"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "peer_median",
                "direction",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "peer_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "asset_id",
          "name",
          "profile",
          "comparison_group",
          "score",
          "rank",
          "dimension_scores",
          "dimension_coverage",
          "factor_scores",
          "comparison_as_of",
          "peer_evidence",
          "peer_counts",
          "gaps",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "deep_research_queue": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TWSE|TPEx):[0-9A-Z]+$"
      },
      "uniqueItems": true
    },
    "queue_policy": {
      "type": "string",
      "minLength": 1
    },
    "deferred_groups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deferred_ranked_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TWSE|TPEx):[0-9A-Z]+$"
      }
    },
    "research_artifacts_complete": {
      "type": "boolean"
    },
    "validated_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^(TWSE|TPEx):[0-9A-Z]+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "asset_id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^(TWSE|TPEx):[0-9A-Z]+$"
          },
          "status": {
            "enum": [
              "pending",
              "evaluated",
              "excluded",
              "needs_data",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "details": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "asset_id",
          "status",
          "attempts",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://investment-manager.local/schemas/market-snapshot.schema.json#/$defs/source"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_context": {
      "$ref": "https://investment-manager.example/schemas/research-context.schema.json"
    }
  },
  "required": [
    "campaign_version",
    "campaign_id",
    "snapshot_id",
    "data_mode",
    "scope",
    "as_of",
    "methodology",
    "policy",
    "coverage",
    "status",
    "ranking",
    "deep_research_queue",
    "queue_policy",
    "deferred_groups",
    "deferred_ranked_assets",
    "research_artifacts_complete",
    "validated_drafts",
    "items",
    "sources",
    "limitations",
    "research_context"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "processing_complete": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ranking": {
            "maxItems": 0
          },
          "deep_research_queue": {
            "maxItems": 0
          },
          "status": {
            "const": "processing"
          }
        }
      }
    }
  ]
}
